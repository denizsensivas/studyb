DATABASE_URL="postgresql://studyb:studyb_secret@localhost:5432/studyb?schema=public"
JWT_SECRET="change-me-to-a-strong-random-secret"
PORT=3001
NODE_ENV=development

# Redis (required in production; local default matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=2000
CACHE_TTL_SECONDS=60

# Distributed API rate limits
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_REQUESTS=10
# Set false in production so an unavailable Redis cannot bypass protection.
RATE_LIMIT_FAIL_OPEN=false
# Number of trusted reverse proxies (Railway and the production compose use 1).
TRUST_PROXY=0

# Cloudflare R2 (private document storage)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="studyb-documents"
